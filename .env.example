# Rebrickable API Key (Get a free key at https://rebrickable.com/api/)
REBRICKABLE_API_KEY=your_rebrickable_api_key_here

# Google Sheets Configuration
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id_here/edit?gid=0#gid=0
# Optional: Bearer token if sheet is private (otherwise use `gcloud auth login --enable-gdrive-access`)
GOOGLE_ACCESS_TOKEN=

# Gemini API Key for AI-generated set trivia & fun facts (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 Media Storage (Zero-egress asset hosting)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=legocard-media
MEDIA_BASE_URL=https://legocard-media.bramp.net
