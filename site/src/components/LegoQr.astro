---
interface Props {
  setId: string;
  format?: 'svg' | 'webp' | 'png' | 'picture';
  alt?: string;
  class?: string;
  size?: number;
}

const {
  setId,
  format = 'picture',
  alt = `Lego QR code for set #${setId}`,
  class: className = '',
  size = 400,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const svgUrl = `${baseUrl}/qr/${setId}.svg`;
const webpUrl = `${baseUrl}/qr/${setId}.webp`;
const pngUrl = `${baseUrl}/qr/${setId}.png`;
---

{
  format === 'picture' && (
    <picture class={className}>
      <source srcset={webpUrl} type="image/webp" />
      <img
        src={pngUrl}
        alt={alt}
        width={size}
        height={size}
        class="w-full h-full object-contain"
        loading="lazy"
        decoding="async"
      />
    </picture>
  )
}

{
  format === 'svg' && (
    <img
      src={svgUrl}
      alt={alt}
      width={size}
      height={size}
      class={className}
      loading="lazy"
      decoding="async"
    />
  )
}

{
  format === 'webp' && (
    <img
      src={webpUrl}
      alt={alt}
      width={size}
      height={size}
      class={className}
      loading="lazy"
      decoding="async"
    />
  )
}

{
  format === 'png' && (
    <img
      src={pngUrl}
      alt={alt}
      width={size}
      height={size}
      class={className}
      loading="lazy"
      decoding="async"
    />
  )
}
