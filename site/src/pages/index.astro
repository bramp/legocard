---
import Layout from '../layouts/Layout.astro';
import { getLegoSets } from '../lib/sets';
import { getSetImageUrl } from '../lib/assets';
import { formatBuildTime } from '../../../shared/format.js';

const sets = getLegoSets();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Compute collection stats
const totalPieces = sets.reduce((sum, s) => sum + (s.pieces || 0), 0);
const totalHours = sets.reduce((sum, s) => sum + (s.buildTimeHours || 0), 0);
---

<Layout title="Collection Gallery">
  <!-- Collection summary stats -->
  <section class="mb-6 grid grid-cols-3 gap-2 sm:gap-4">
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-xl p-3 text-center">
      <span class="block text-xl sm:text-3xl font-black text-amber-400">{sets.length}</span>
      <span class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-slate-400">Sets</span>
    </div>
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-xl p-3 text-center">
      <span class="block text-xl sm:text-3xl font-black text-emerald-400">{totalPieces.toLocaleString()}</span>
      <span class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-slate-400">Pieces</span>
    </div>
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-xl p-3 text-center">
      <span class="block text-xl sm:text-3xl font-black text-sky-400">{totalHours.toFixed(1)}h</span>
      <span class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-slate-400">Build Time</span>
    </div>
  </section>

  <!-- Search & filter bar -->
  <div class="mb-6 space-y-2">
    <div class="relative">
      <input
        type="search"
        id="searchInput"
        placeholder="Search sets by name, set number, theme, collection..."
        class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 pl-10 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all"
      />
      <span class="absolute left-3.5 top-3.5 text-slate-500 pointer-events-none">🔍</span>
    </div>
  </div>

  <!-- Responsive Collectible Card Grid -->
  <div id="setsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {sets.map((set) => (
      <a
        href={`${baseUrl}/sets/${set.id}`}
        data-name={set.name.toLowerCase()}
        data-id={set.id}
        data-theme={(set.theme || '').toLowerCase()}
        data-collection={(set.collection || '').toLowerCase()}
        class="set-card group bg-slate-900/70 hover:bg-slate-900 border border-slate-800/90 hover:border-amber-500/50 rounded-2xl overflow-hidden transition-all duration-200 flex flex-col shadow-lg hover:shadow-amber-500/5"
      >
        <!-- Card Image Header -->
        <div class="relative aspect-video sm:aspect-square bg-slate-950 flex items-center justify-center overflow-hidden p-4">
          <img
            src={getSetImageUrl(set)}
            alt={set.name}
            loading="lazy"
            class="object-contain w-full h-full max-h-48 sm:max-h-56 group-hover:scale-105 transition-transform duration-300"
          />
          <span class="absolute top-2.5 left-2.5 bg-slate-950/80 backdrop-blur-md border border-slate-700/80 text-amber-400 text-xs font-mono font-bold px-2 py-0.5 rounded-md">
            #{set.id}
          </span>
          {set.year && (
            <span class="absolute top-2.5 right-2.5 bg-slate-950/80 backdrop-blur-md border border-slate-700/80 text-slate-300 text-xs font-semibold px-2 py-0.5 rounded-md">
              {set.year}
            </span>
          )}
        </div>

        <!-- Card Content Details -->
        <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-[10px] font-bold uppercase tracking-wider text-amber-500/90 line-clamp-1">
                {set.theme || 'Lego'}
              </span>
              {set.collection && (
                <span class="text-[9px] font-semibold bg-amber-500/10 border border-amber-500/30 text-amber-300 px-1.5 py-0.5 rounded-md line-clamp-1">
                  {set.collection}
                </span>
              )}
            </div>
            <h2 class="font-bold text-base text-slate-100 group-hover:text-amber-400 transition-colors line-clamp-2 mt-0.5">
              {set.name}
            </h2>
          </div>

          <!-- Micro specs badges -->
          <div class="pt-2 border-t border-slate-800/80 grid grid-cols-2 gap-2 text-xs text-slate-400">
            <div>
              <span class="text-slate-500 block text-[10px]">Pieces</span>
              <span class="font-semibold text-slate-200">{set.pieces ? set.pieces.toLocaleString() : 'N/A'}</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">Build Time</span>
              <span class="font-semibold text-slate-200">{formatBuildTime(set) || 'N/A'}</span>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>

  <p id="emptyState" class="hidden text-center py-12 text-sm text-slate-500">
    No Lego sets match your search.
  </p>
</Layout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.set-card');
  const emptyState = document.getElementById('emptyState');

  searchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const id = card.dataset.id || '';
      const theme = card.dataset.theme || '';
      const collection = card.dataset.collection || '';
      const matches = name.includes(q) || id.includes(q) || theme.includes(q) || collection.includes(q);

      if (matches) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
  });
</script>
