---
import Layout from '../../layouts/Layout.astro';
import LegoQr from '../../components/LegoQr.astro';
import { getLegoSets } from '../../lib/sets';
import { getSetMediaUrls } from '../../lib/assets';
import { formatBuildTime } from '../../../../shared/format.js';

export function getStaticPaths() {
  const sets = getLegoSets();
  return sets.map((set) => ({
    params: { id: set.id },
    props: { set },
  }));
}

const { set } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const media = getSetMediaUrls(set);
---

<Layout
  title={`${set.name} (#${set.id})`}
  description={`Lego Set #${set.id}: ${set.name}. ${set.pieces || 0} pieces. Built in ${set.buildTimeHours || 'several'} hours.`}
  image={media.image}
>
  <div class="space-y-6">
    <!-- Top Bar Navigation & Actions -->
    <div class="flex items-center justify-between text-sm">
      <a
        href={`${baseUrl}/`}
        class="inline-flex items-center gap-1.5 text-slate-400 hover:text-white font-medium transition-colors"
      >
        <span class="text-base">‹</span> All Sets
      </a>

      <!-- Quick Action: Show QR modal for NFC/physical tag sharing -->
      <button
        id="openQrBtn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:border-slate-500 text-xs font-semibold text-slate-300 hover:text-white transition-colors cursor-pointer"
      >
        <span>📱</span> Show QR
      </button>
    </div>

    <!-- Main Collectible Mobile Card -->
    <article class="bg-slate-900/80 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl backdrop-blur-sm">
      <!-- Hero Image Container with Touch Zoom Feel -->
      <div class="relative bg-gradient-to-b from-slate-950 to-slate-900 p-6 flex items-center justify-center min-h-[300px] sm:min-h-[400px]">
        <img
          src={media.image}
          alt={set.name}
          class="object-contain max-h-[320px] sm:max-h-[420px] w-full drop-shadow-[0_20px_35px_rgba(0,0,0,0.8)]"
        />

        <div class="absolute top-4 left-4 flex gap-2">
          <span class="bg-amber-500/20 text-amber-400 border border-amber-500/40 font-mono font-bold text-xs px-2.5 py-1 rounded-full">
            #{set.id}
          </span>
          {set.year && (
            <span class="bg-slate-950/80 text-slate-300 border border-slate-800 text-xs font-medium px-2.5 py-1 rounded-full">
              {set.year}
            </span>
          )}
        </div>
      </div>

      <!-- Card Body Content -->
      <div class="p-5 sm:p-8 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-500">
            {set.theme || 'Lego Collection'}
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
            {set.name}
          </h1>
        </div>

        <!-- 4-Stat Metric Grid for Mobile Scanners -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Pieces</span>
            <span class="text-xl font-black text-slate-100">{set.pieces ? set.pieces.toLocaleString() : '—'}</span>
          </div>

          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Build Time</span>
            <span class="text-sm sm:text-base font-black text-amber-400 leading-snug block mt-0.5">
              {formatBuildTime(set) || '—'}
            </span>
          </div>

          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Completed</span>
            <span class="text-sm font-bold text-slate-200 truncate block mt-0.5">
              {set.buildDate || '—'}
            </span>
          </div>

          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Theme</span>
            <span class="text-sm font-bold text-slate-200 truncate block mt-0.5">
              {set.theme || 'Lego'}
            </span>
          </div>
        </div>

        <!-- Release / Retirement Timeline Badges if available -->
        {(set.dateReleased || set.dateRetired || set.age || set.dimensions || set.instructionBooks) && (
          <div class="flex flex-wrap gap-2 text-xs">
            {set.age && (
              <span class="bg-slate-950/60 border border-slate-800 text-slate-400 px-3 py-1.5 rounded-xl">
                <strong class="text-slate-300">Age:</strong> {set.age}
              </span>
            )}
            {set.instructionBooks && (
              <span class="bg-slate-950/60 border border-slate-800 text-slate-400 px-3 py-1.5 rounded-xl">
                <strong class="text-slate-300">Instruction Books:</strong> {set.instructionBooks}
              </span>
            )}
            {set.dimensions && (set.dimensions.height || set.dimensions.width || set.dimensions.depth) && (
              <span class="bg-slate-950/60 border border-slate-800 text-slate-400 px-3 py-1.5 rounded-xl">
                <strong class="text-slate-300">Size:</strong> {[
                  set.dimensions.height ? `${set.dimensions.height}cm H` : null,
                  set.dimensions.width ? `${set.dimensions.width}cm W` : null,
                  set.dimensions.depth ? `${set.dimensions.depth}cm D` : null,
                ].filter(Boolean).join(' × ')}
              </span>
            )}
            {set.dateReleased && (
              <span class="bg-slate-950/60 border border-slate-800 text-slate-400 px-3 py-1.5 rounded-xl">
                <strong class="text-slate-300">Released:</strong> {set.dateReleased}
              </span>
            )}
            {set.dateRetired && (
              <span class="bg-slate-950/60 border border-slate-800 text-slate-400 px-3 py-1.5 rounded-xl">
                <strong class="text-slate-300">Retired:</strong> {set.dateRetired}
              </span>
            )}
          </div>
        )}

        <!-- Official Photo Gallery -->
        {set.images && set.images.length > 1 && (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <span>🖼️</span> Official Gallery ({set.images.length} photos)
              </span>
              <span class="text-[11px] font-normal text-slate-500">Tap to expand</span>
            </h3>
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2 sm:gap-3">
              {set.images.map((imgUrl, idx) => (
                <a
                  href={imgUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="aspect-square rounded-xl bg-slate-900/90 border border-slate-800 hover:border-amber-500/50 p-1.5 sm:p-2 flex items-center justify-center overflow-hidden transition group"
                  title={`${set.name} Photo ${idx + 1}`}
                >
                  <img
                    src={imgUrl}
                    alt={`${set.name} photo ${idx + 1}`}
                    loading="lazy"
                    class="max-h-full max-w-full object-contain group-hover:scale-110 transition-transform duration-200"
                  />
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Official LEGO Videos -->
        {set.productVideos && set.productVideos.length > 0 && (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-1.5">
              <span>🎥</span> Official LEGO Videos ({set.productVideos.length})
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {set.productVideos.map((vid) => (
                <div class="rounded-xl overflow-hidden bg-black border border-slate-800">
                  <video
                    src={vid.url}
                    controls
                    playsinline
                    preload="none"
                    class="w-full aspect-video object-contain"
                  />
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Official LEGO Features & Overview -->
        {set.featuresText && (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
              <span>✨</span> Set Features & Details
            </h3>
            <div class="text-xs sm:text-sm leading-relaxed text-slate-300 space-y-2 [&_p]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1 [&_li]:text-slate-300" set:html={set.featuresText} />
          </div>
        )}

        <!-- Fun Facts & Trivia -->
        {set.funFacts && (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
              <span>💡</span> Fun Facts & Highlights
            </h3>
            <p class="text-sm leading-relaxed text-slate-300">
              {set.funFacts}
            </p>
          </div>
        )}

        <!-- Personal Display Notes -->
        {set.notes && (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
              <span>📍</span> Display & Notes
            </h3>
            <p class="text-sm leading-relaxed text-slate-300">
              {set.notes}
            </p>
          </div>
        )}

        <!-- Video Highlight Showcase -->
        {media.video ? (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-1.5">
              <span>🎬</span> Video Showcase
            </h3>
            <div class="aspect-[9/16] max-w-xs mx-auto rounded-xl overflow-hidden bg-black shadow-lg">
              <video
                src={media.video}
                controls
                playsinline
                preload="metadata"
                poster={media.image}
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        ) : (
          <div class="border border-dashed border-slate-800 rounded-2xl p-5 text-center bg-slate-950/30">
            <span class="text-2xl mb-1 block">🎬</span>
            <h4 class="text-sm font-bold text-slate-200">Video Showcase Coming Soon</h4>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
              A vertical 9:16 highlight reel with animated stats and voiceover is being generated for this set.
            </p>
          </div>
        )}
      </div>
    </article>
  </div>

  <!-- Modal / Drawer for Displaying Set's QR Code for Scanning -->
  <dialog
    id="qrModal"
    class="fixed inset-0 m-auto bg-slate-900 text-slate-100 rounded-3xl border border-slate-700 p-5 sm:p-6 w-[calc(100%-2rem)] max-w-sm sm:max-w-md shadow-2xl backdrop:bg-slate-950/80 backdrop:backdrop-blur-sm"
  >
    <div class="text-center space-y-4">
      <div class="flex items-center justify-between">
        <span class="font-bold text-sm text-slate-200">Scan to View Set</span>
        <button id="closeQrBtn" type="button" class="text-slate-400 hover:text-white text-lg font-bold cursor-pointer p-1">✕</button>
      </div>

      <div class="bg-white p-3 sm:p-4 rounded-2xl shadow-inner flex items-center justify-center">
        <LegoQr
          setId={set.id}
          format="picture"
          class="w-full aspect-square max-w-[340px] flex items-center justify-center"
          alt={`Lego QR code for set #${set.id}`}
        />
      </div>

      <div class="text-xs text-slate-400">
        <p class="font-semibold text-slate-300">#{set.id} • {set.name}</p>
        <p class="text-[11px] text-slate-500 mt-0.5">Program this direct URL onto an NFC tag or scan with any camera.</p>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const openBtn = document.getElementById('openQrBtn');
  const closeBtn = document.getElementById('closeQrBtn');
  const modal = document.getElementById('qrModal') as HTMLDialogElement | null;

  openBtn?.addEventListener('click', () => modal?.showModal());
  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
</script>
