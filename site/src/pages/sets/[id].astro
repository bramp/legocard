---
import Layout from '../../layouts/Layout.astro';
import { getLegoSets } from '../../lib/sets';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const sets = getLegoSets();
  return sets.map((set) => ({
    params: { id: set.id },
    props: { set },
  }));
}

const { set } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Check if QR code SVG exists locally
let qrSvgContent: string | null = null;
const qrPath = path.resolve(process.cwd(), `../data/qr/${set.id}.svg`);
const altQrPath = path.resolve(process.cwd(), `data/qr/${set.id}.svg`);
const resolvedQr = fs.existsSync(qrPath) ? qrPath : altQrPath;
if (fs.existsSync(resolvedQr)) {
  qrSvgContent = fs.readFileSync(resolvedQr, 'utf-8');
}
---

<Layout
  title={`${set.name} (#${set.id})`}
  description={`Lego Set #${set.id}: ${set.name}. ${set.pieces || 0} pieces. Built in ${set.buildTimeHours || 'several'} hours.`}
  image={set.imageUrl}
>
  <div class="space-y-6">
    <!-- Top Bar Navigation & Actions -->
    <div class="flex items-center justify-between text-sm">
      <a
        href={`${baseUrl}/`}
        class="inline-flex items-center gap-1.5 text-slate-400 hover:text-white font-medium transition-colors"
      >
        <span class="text-base">‹</span> All Sets
      </a>

      <!-- Quick Action: Show QR modal for NFC/physical tag sharing -->
      <button
        id="openQrBtn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:border-slate-500 text-xs font-semibold text-slate-300 hover:text-white transition-colors cursor-pointer"
      >
        <span>📱</span> Show QR
      </button>
    </div>

    <!-- Main Collectible Mobile Card -->
    <article class="bg-slate-900/80 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl backdrop-blur-sm">
      <!-- Hero Image Container with Touch Zoom Feel -->
      <div class="relative bg-gradient-to-b from-slate-950 to-slate-900 p-6 flex items-center justify-center min-h-[300px] sm:min-h-[400px]">
        <img
          src={set.imageUrl}
          alt={set.name}
          class="object-contain max-h-[320px] sm:max-h-[420px] w-full drop-shadow-[0_20px_35px_rgba(0,0,0,0.8)]"
        />

        <div class="absolute top-4 left-4 flex gap-2">
          <span class="bg-amber-500/20 text-amber-400 border border-amber-500/40 font-mono font-bold text-xs px-2.5 py-1 rounded-full">
            #{set.id}
          </span>
          {set.year && (
            <span class="bg-slate-950/80 text-slate-300 border border-slate-800 text-xs font-medium px-2.5 py-1 rounded-full">
              {set.year}
            </span>
          )}
        </div>

        {set.rating && (
          <div class="absolute top-4 right-4 bg-slate-950/80 border border-slate-800 text-amber-400 font-bold text-xs px-2.5 py-1 rounded-full flex items-center gap-1">
            <span>★</span> {set.rating}/5
          </div>
        )}
      </div>

      <!-- Card Body Content -->
      <div class="p-5 sm:p-8 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-500">
            {set.theme || 'Lego Collection'}
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
            {set.name}
          </h1>
        </div>

        <!-- 4-Stat Metric Grid for Mobile Scanners -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Pieces</span>
            <span class="text-xl font-black text-slate-100">{set.pieces ? set.pieces.toLocaleString() : '—'}</span>
          </div>

          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Build Time</span>
            <span class="text-xl font-black text-amber-400">
              {set.buildTimeHours ? `${set.buildTimeHours}h` : '—'}
            </span>
          </div>

          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Completed</span>
            <span class="text-sm font-bold text-slate-200 truncate block mt-0.5">
              {set.buildDate || '—'}
            </span>
          </div>

          <div class="bg-slate-950/70 border border-slate-800/90 rounded-2xl p-3.5">
            <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500 block">Built By</span>
            <span class="text-sm font-bold text-slate-200 truncate block mt-0.5">
              {set.builtBy || 'Family'}
            </span>
          </div>
        </div>

        <!-- Fun Facts & Trivia -->
        {set.funFacts && (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
              <span>💡</span> Fun Facts & Highlights
            </h3>
            <p class="text-sm leading-relaxed text-slate-300">
              {set.funFacts}
            </p>
          </div>
        )}

        <!-- Personal Display Notes -->
        {set.notes && (
          <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 sm:p-5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
              <span>📍</span> Display & Notes
            </h3>
            <p class="text-sm leading-relaxed text-slate-300">
              {set.notes}
            </p>
          </div>
        )}

        <!-- Video Highlight Placeholder (Phase 2 integration) -->
        <div class="border border-dashed border-slate-800 rounded-2xl p-5 text-center bg-slate-950/30">
          <span class="text-2xl mb-1 block">🎬</span>
          <h4 class="text-sm font-bold text-slate-200">Video Showcase Coming Soon</h4>
          <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
            A vertical 9:16 highlight reel with animated stats and voiceover is being generated for this set.
          </p>
        </div>
      </div>
    </article>
  </div>

  <!-- Modal / Drawer for Displaying Set's QR Code for Scanning -->
  <dialog id="qrModal" class="bg-slate-900 text-slate-100 rounded-3xl border border-slate-700 p-6 max-w-xs w-full shadow-2xl backdrop:bg-slate-950/80">
    <div class="text-center space-y-4">
      <div class="flex items-center justify-between">
        <span class="font-bold text-sm text-slate-200">Scan to View Set</span>
        <button id="closeQrBtn" type="button" class="text-slate-400 hover:text-white text-lg font-bold">✕</button>
      </div>

      <div class="bg-white p-4 rounded-2xl shadow-inner flex items-center justify-center">
        {qrSvgContent ? (
          <div class="w-48 h-48" set:html={qrSvgContent} />
        ) : (
          <div class="w-48 h-48 flex items-center justify-center text-xs text-slate-400">
            QR code ready upon build
          </div>
        )}
      </div>

      <div class="text-xs text-slate-400">
        <p class="font-semibold text-slate-300">#{set.id} • {set.name}</p>
        <p class="text-[11px] text-slate-500 mt-0.5">Program this direct URL onto an NFC tag or scan with any camera.</p>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const openBtn = document.getElementById('openQrBtn');
  const closeBtn = document.getElementById('closeQrBtn');
  const modal = document.getElementById('qrModal') as HTMLDialogElement | null;

  openBtn?.addEventListener('click', () => modal?.showModal());
  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
</script>
