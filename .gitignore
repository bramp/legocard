# Environment variables
.env
.env.local

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
.astro/
build/
out/

# Raw CSV spreadsheets and backups (local data source; public metadata lives in sets.json)
data/*.csv

# Local API caches (Rebrickable, Bricklink, etc.)
data/cache/

# Downloaded stock photos (cached locally, site uses CDN URLs)
data/images/

# Generated voiceover audio and subtitles (cached locally, site uses CDN URLs)
data/audio/

# Rendered MP4 videos (cached locally, site uses CDN URLs)
data/videos/

# Video workspace public assets & outputs
video/public/images/
video/public/audio/
video/public/videos/
video/out/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
